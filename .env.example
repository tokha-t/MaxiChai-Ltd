# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ===== API организаторов =====
# Ссылку из гайда можно вставить как есть: group_id подставляется автоматически
ORG_API_URL=https://...powerplatform.com/powerautomate/automations/direct/.../invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=...

# ===== Модели-судьи (бесплатно) =====
# Gemini: ключ без карты за 2 минуты — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras (необязательно, второй бесплатный провайдер): https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=
# GROQ_API_KEY=  OPENROUTER_API_KEY=  MISTRAL_API_KEY=  GITHUB_TOKEN=   — тоже поддерживаются

# Судьи через запятую в формате провайдер:модель. Голоса раздаются по кругу:
# у каждой модели свой бесплатный лимит, а оценка получается ансамблем разных моделей.
# Судья без ключа или с неверным именем модели автоматически пропускается.
# Точные имена моделей: python -m cqa models --provider gemini --filter flash
# Проверка, что все отвечают: python -m cqa ping
LLM_JUDGES=gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,cerebras:gpt-oss-120b
LLM_VOTES=3            # голосов на диалог (каждый голос — один вызов со всеми критериями)
LLM_MODE=batch         # batch — все критерии одним вызовом (экономит лимиты); per_criterion — вызов на критерий

# Темп запросов на одну модель (бесплатные тарифы иначе отвечают 429)
GEMINI_RPM=10
CEREBRAS_RPM=5

# Локальная модель (необязательно): установите Ollama, выполните `ollama pull gpt-oss:20b`
# и добавьте судью ollama:gpt-oss:20b — тогда results.json получит mode=hybrid или local.

# Платные модели (если понадобятся): openai:<модель> + OPENAI_API_KEY, цены за 1M токенов
# PRICE_INPUT_PER_M=1.00
# PRICE_CACHED_INPUT_PER_M=0.05
# PRICE_OUTPUT_PER_M=5.00

# ===== Сдача =====
TEAM_NAME=MaxiChai
# MODEL_MODE определяется сам: external_api / local / hybrid. Задайте вручную только при необходимости.

# Для разработки интерфейса без моделей: LLM_PROVIDER=mock (оценки — заглушки)
